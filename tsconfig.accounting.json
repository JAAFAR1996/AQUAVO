// Strict typecheck for the MONEY-CRITICAL services only.
// The repo-wide server config sets "noCheck": true (legacy debt), so these files
// would otherwise never be verified. This config actually checks them — `type Db = any`
// cannot come back without failing `npm run check:accounting`.
{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["./shared/*"] },
    "types": ["node"]
  },
  "include": [
    "shared/schema.ts",
    "shared/order-financials.ts",
    "shared/cost-components.ts",
    "server/services/fulfillment-db.ts",
    "server/services/fulfillment-service.ts",
    "server/services/fulfillment-draft-service.ts",
    "server/services/packaging-profile-service.ts",
    "server/services/material-cost-service.ts",
    "server/services/fulfillment-types.test-d.ts"
  ]
}
