// Strict typecheck for money-critical services and routes.
{
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@shared/*": ["./shared/*"] },
    "types": ["node"]
  },
  "include": [
    "shared/schema.ts",
    "shared/accounting-schema-v2.ts",
    "shared/cod-accounting.ts",
    "shared/order-financials.ts",
    "shared/cost-components.ts",
    "server/routes/accounting-v2.ts",
    "server/routes/admin-orders-v2.ts",
    "server/routes/invoice-v2.ts",
    "server/services/accounting-engine.ts",
    "server/services/fulfillment-db.ts",
    "server/services/fulfillment-verifier.ts",
    "server/services/fulfillment-service.ts",
    "server/services/fulfillment-draft-service.ts",
    "server/services/packaging-profile-service.ts",
    "server/services/material-cost-service.ts",
    "server/services/fulfillment-types.test-d.ts",
    "shared/packing-types.ts",
    "shared/packing-schema.ts",
    "server/services/carton-geometry-adapter.ts",
    "server/services/carton-support-analyzer.ts",
    "server/services/carton-load-distributor.ts",
    "server/services/carton-safety-validator.ts",
    "server/services/carton-planner.ts",
    "server/services/carton-reservation-service.ts",
    "server/services/packaging-cost-resolver.ts",
    "server/services/return-packaging-loss-service.ts",
    "server/services/admin-alert-service.ts",
    "server/services/packaging-lifecycle.ts",
    "server/services/packaging-lifecycle-runner.ts"
  ]
}
