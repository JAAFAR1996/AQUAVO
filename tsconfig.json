{
  "include": [
    "client/src/**/*",
    "shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "server/**/*",
    "api/**/*"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    // `lib` has always been esnext and Vite transpiles for modern browsers, but
    // `target` was never set, so tsc defaulted to ES5 and rejected the Unicode
    // property escapes (`\p{Script=...}`, which require the `u` flag) and the
    // `matchAll` iteration in shared/script-purity.ts. This only relaxes checks.
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom",
      "node"
    ],
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  }
}