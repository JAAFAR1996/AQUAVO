modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist/public"
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34475
externalPort = 3001

[[ports]]
localPort = 34773
externalPort = 4200

[[ports]]
localPort = 36965
externalPort = 3000

[[ports]]
localPort = 44113
externalPort = 3003

[[ports]]
localPort = 44527
externalPort = 3002

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
mockupState = "FULLSTACK"
expertMode = true

[userenv]

# Secrets are NOT stored here. Set them in the Replit "Secrets" panel
# (or the host's environment). These keys are intentionally left blank in
# version control; the runtime reads them from process.env.
[userenv.shared]
DATABASE_URL = ""
JWT_SECRET = ""
NEXT_PUBLIC_SITE_URL = "https://www.aquavoiq.com"
RESEND_API_KEY = ""
R2_ACCOUNT_ID = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
NEXT_PUBLIC_R2_PUBLIC_URL = "https://pub-a4b6f72ec4db47098ef8158544ad8451.r2.dev"
FROM_EMAIL = "orders@fishweb.iq"
SUPPORT_EMAIL = "support@fishweb.iq"
