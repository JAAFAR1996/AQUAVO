{
  "version": "1.0",
  "protocol": {
    "name": "ACP",
    "version": "1.0",
    "spec": "https://agenticcommerceprotocol.com/spec/v1"
  },
  "merchant": {
    "name": "AQUAVO",
    "description": "Iraq's premier aquarium supplies and fish care e-commerce platform",
    "url": "https://www.aquavoiq.com",
    "logo": "https://www.aquavoiq.com/logo_aquavo_icon.png",
    "country": "IQ",
    "currency": "IQD",
    "language": "ar"
  },
  "capabilities": {
    "catalog": {
      "url": "https://www.aquavoiq.com/api/products",
      "format": "json",
      "description": "Full product catalog with pricing, images, and availability"
    },
    "search": {
      "url": "https://www.aquavoiq.com/api/products?search={query}",
      "format": "json",
      "description": "Search products by name, category, or brand"
    }
  },
  "payment": {
    "methods": ["cash_on_delivery"],
    "currency": "IQD"
  },
  "shipping": {
    "zones": [
      { "name": "Baghdad", "delivery_time": "1-2 business days", "cost": 5000 },
      { "name": "Other Governorates", "delivery_time": "2-4 business days", "cost": 5000 }
    ],
    "free_shipping_threshold": 100000
  },
  "contact": {
    "phone": "+964 774 788 0673",
    "website": "https://www.aquavoiq.com"
  }
}
