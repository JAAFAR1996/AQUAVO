# ========================================
# متغيرات البيئة لـ AQUAVO - Railway
# ========================================

# البيئة
NODE_ENV=production
PORT=5000

# قاعدة البيانات (NEON PostgreSQL)
DATABASE_URL=postgres://user:password@host/database?sslmode=require
# Local QA safety: non-production startup blocks remote DB URLs by default.
# Use true only with a known safe staging/test DB, never production.
ALLOW_REMOTE_DATABASE_IN_DEV=false
# Local browser QA: disable background cron jobs while testing flows.
DISABLE_SCHEDULED_JOBS=false

# الجلسات
SESSION_SECRET=your-very-long-random-secret-here-at-least-32-chars

# ========================================
# Wayl Online Payment (https://docs.thewayl.com)
# ========================================
# Merchant API key from the Wayl dashboard (issued by Wayl; email jisr@wayl.io).
# Sent as the X-WAYL-AUTHENTICATION header. Backend-only; never expose to the client.
# REQUIRED for online payment in every environment (Wayl publishes no sandbox key).
WAYL_API_KEY=
# "test" or "live" — sent as the `env` field on every create-link request (same API host).
# Per Wayl's docs: use "test" while testing, switch to "live" only when going live.
#   - Development / local / preview: if WAYL_ENV is absent it defaults to "test".
#     A non-production environment never silently takes live payments.
#   - Production (NODE_ENV=production): WAYL_ENV=live is REQUIRED and must be set
#     explicitly. Missing, "test" or any other value disables online checkout
#     (fail closed with a configuration error) — there is no fallback.
WAYL_ENV=test
# Optional override of the API host. Default: https://api.thewayl.com
WAYL_API_BASE_URL=
# Readiness probe is for non-production diagnostics only. Production availability
# checks config + GET /api/v1/verify-auth-key and creates the real payment link only
# after the customer submits checkout. The real create-link call remains authoritative
# and still fails closed if Wayl has not enabled the merchant.
WAYL_READINESS_PROBE=on
# Soft stock reservation while a customer is on the hosted payment page (5-60 minutes).
WAYL_RESERVATION_TTL_MINUTES=15
# Note: no static WAYL_WEBHOOK_SECRET is needed. A fresh random secret is generated
# per payment link, sent to Wayl as `webhookSecret`, stored with the payment, and used
# to verify the x-wayl-signature-256 HMAC on incoming webhooks.

# ========================================
# Al-Waseet Tracking Mirror (تتبع الوسيط فقط)
# ========================================
# Disabled by default for safe rollout. The integration is read-only: it does not
# create/edit shipments and never changes AQUAVO order/accounting/fulfillment status.
ALWASEET_TRACKING_ENABLED=false
ALWASEET_USERNAME=
ALWASEET_PASSWORD=
# Required when Al-Waseet tracking is enabled. Injected by the Fixie/Vercel integration.
# Contains proxy credentials; never expose it to the browser or commit a real value.
FIXIE_URL=

# ========================================
# WhatsApp Cloud API — Post-delivery lifecycle
# ========================================
# Keep disabled until the real Meta number/system-user token, approved delivery-care
# template, signed messages webhook and controlled live test are verified.
# Never commit real tokens/secrets to git.
WHATSAPP_CLOUD_ENABLED=false
# REQUIRED before enabling live sends. Set once to the exact ISO-8601 rollout instant
# (prefer UTC, e.g. 2026-08-19T12:00:00Z). Jobs created before this boundary are
# cancelled instead of being sent later as a stale rollout backlog.
WHATSAPP_DELIVERY_CARE_ACTIVATION_AT=
# AQUAVO's currently configured Meta Graph API version. Re-verify before upgrading.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Approved template body must match exactly, preserving line breaks:
# هلا أستاذ {{1}} 🌿
# حبينا نطمن على طلبك بعد التوصيل.
# إذا استلمته، كل القطع وصلت كاملة وبحالة زينة؟
# {{1}} = customer first name only.
# Quick Reply buttons, in order:
# 0) وصلتني وكلشي تمام
# 1) عندي ملاحظة عالطلب
WHATSAPP_DELIVERY_CARE_TEMPLATE=aquavo_delivery_care_v1

# Optional combined post-delivery care + UGC discount message.
# Category: MARKETING. It is used instead of the Utility delivery-care template
# only for customers with a current explicit WhatsApp marketing opt-in.
# Keep disabled until the exact template is Approved/Active in WhatsApp Manager.
WHATSAPP_DELIVERY_CARE_MARKETING_ENABLED=false
# Independent rollout boundary for the marketing variant. A delivery-care job
# created before this instant can never switch from Utility to Marketing later.
WHATSAPP_DELIVERY_CARE_MARKETING_ACTIVATION_AT=
# Exact proposed body:
# السلام عليكم أستاذ {{1}}
# حبينا نطمن عليك بعد استلام طلبك من AQUAVO، وإن شاء الله وصلك كامل وبحالة ممتازة.
# إذا عندك أي ملاحظة، حتى لو بسيطة، دزلنا هنا مباشرة.
# وإذا حبيت تشارك لحظة فتح الطلب على إنستغرام، حتى تصوير بسيط يكفي:
# ستوري + منشن @aquavo_iq = خصم 5% على طلبك الجاي
# ريلز لفتح الطلب + منشن @aquavo_iq = خصم 10% على طلبك الجاي
# شارك تجربتك بطريقتك ومثل ما هي، ومن تسويلنا منشن ندزلك كود الخصم مباشرة
# Quick Reply buttons remain:
# 0) وصلتني وكلشي تمام
# 1) عندي ملاحظة عالطلب
WHATSAPP_DELIVERY_CARE_MARKETING_TEMPLATE=aquavo_delivery_care_ugc_v1
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Growth OS lifecycle automation. Keep disabled until BOTH templates below are
# approved in WhatsApp Manager and a controlled live test passes.
WHATSAPP_LIFECYCLE_ENABLED=false
# Required rollout boundary. Old jobs/orders are suppressed instead of creating
# a stale messaging burst when automation is first enabled.
WHATSAPP_LIFECYCLE_ACTIVATION_AT=
# Utility template (order-specific service follow-up), category: UTILITY
# Exact body:
# هلا أستاذ {{1}}
# صار تقريباً أسبوع على استلام طلبك رقم {{2}} من AQUAVO.
# حبينا نطمن: كلشي تمام ويا المنتجات والحوض؟
# إذا عندك أي ملاحظة أو تحتاج مساعدة، رد علينا هنا.
# Buttons:
# 0) كلشي تمام
# 1) أحتاج مساعدة
WHATSAPP_DAY7_CARE_TEMPLATE=aquavo_day7_care_v1
# Replenishment is marketing. It remains independently disabled until the
# MARKETING template is approved and explicit checkout opt-in is being captured.
WHATSAPP_REPURCHASE_ENABLED=false
# Marketing template, category: MARKETING
# Exact body:
# هلا أستاذ {{1}}
# حسب طلبك السابق من AQUAVO، ممكن يكون {{2}} قرب يخلص.
# إذا تحتاجه من جديد، نراجع احتياج حوضك ونرتبلك المناسب فقط.
# Buttons:
# 0) أحتاجه
# 1) إيقاف التذكيرات
WHATSAPP_REPURCHASE_TEMPLATE=aquavo_repurchase_reminder_v1

# Active signed webhook callback:
# https://www.aquavoiq.com/api/webhooks/whatsapp
# The Meta app/WABA must be subscribed to the WhatsApp `messages` webhook field.
# Use a long random verify token. META_APP_SECRET must be the App Secret belonging
# to the Meta app that owns/subscribes the WhatsApp Business Account webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# External five-minute recovery worker. The exact same secret must exist as the
# GitHub Actions repository secret CRON_SECRET; never print or commit the real value.
CRON_SECRET=
# Review templates remain disabled until secure order-token review URLs are live.
WHATSAPP_REVIEW_TEMPLATE=aquavo_review_request_v1
WHATSAPP_REVIEW_REMINDER_TEMPLATE=aquavo_review_reminder_v1
POST_DELIVERY_REVIEW_AUTOMATION_ENABLED=false

# Cloudinary (صور المنتجات)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare R2 (صور المراجعات)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_BUCKET_NAME=aquavo
CLOUDFLARE_CDN_URL=https://your-cdn-url.r2.dev

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@aquavoiq.com

# البريد الإلكتروني (Resend)
# Backend uses Resend directly; legacy SMTP_HOST/PORT/USER/PASS values are ignored.
# RESEND_API_KEY is required for transactional email. SMTP_FROM must use a
# domain verified in Resend before marketing fanout is enabled.
RESEND_API_KEY=
SMTP_FROM=AQUAVO <info@aquavoiq.com>
# Weekly marketing campaigns are opt-in and fail closed unless all readiness
# requirements above are satisfied.
EMAIL_CAMPAIGNS_ENABLED=false

# رابط الموقع العام
VITE_PUBLIC_BASE_URL=https://www.aquavoiq.com
CLIENT_URL=https://www.aquavoiq.com
AQUAVO_BASE_URL=https://www.aquavoiq.com

# MCP (AI client access)
# Use long random secrets in production. Do not commit real values.
AQUAVO_MCP_SECRET=your-mcp-jwt-secret-at-least-32-chars
AQUAVO_MCP_TOKEN=your-local-static-mcp-token
# Static token scopes: use "mcp:read" for read-only, or "mcp:read mcp:write" for controlled writes.
AQUAVO_MCP_STATIC_SCOPES=mcp:read mcp:write
# Extra origins/hosts allowed to call /api/mcp. Defaults include Claude, ChatGPT, aquavoiq.com, and local dev.
AQUAVO_MCP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com,https://chat.openai.com,https://www.aquavoiq.com,https://aquavoiq.com
AQUAVO_MCP_ALLOWED_HOSTS=www.aquavoiq.com,aquavoiq.com,localhost:5000,localhost:3000,127.0.0.1:5000,127.0.0.1:3000
# Optional: admin user id used to persist MCP write audit rows into audit_logs.
AQUAVO_MCP_AUDIT_USER_ID=

# Frontend (Vite)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Groq AI (Ultra-fast LLM - Multiple keys for failover)
# Get keys from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_2=your-backup-groq-key-2
GROQ_API_KEY_3=your-backup-groq-key-3

# Groq Finance Audit (تدقيق المحاسبة الآلي)
# Dedicated API key for finance audit — must NOT fall back to GROQ_API_KEY
FINANCE_GROQ_API_KEY=your-finance-groq-api-key
# Model used for audit reports (default: llama-3.1-8b-instant)
FINANCE_GROQ_MODEL=llama-3.1-8b-instant
# Set to true to enable the audit endpoint + scheduled job (disabled by default for safety)
FINANCE_AI_AUDIT_ENABLED=false
# How often to run the scheduled audit (hours, default: 12)
FINANCE_AI_AUDIT_INTERVAL_HOURS=12
# NEVER set this to true — auto-fix is not implemented and will never be applied automatically
FINANCE_AI_AUTO_FIX=false
# Send Telegram alert even for clean ok reports (default: false — alerts only on warning/critical/failed)
FINANCE_AUDIT_ALERT_ON_OK=false

# ========================================
# Telegram Monitoring Alerts (تنبيهات المراقبة)
# ========================================
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your Telegram chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ========================================
# Social Media Analytics (تحليلات السوشيال ميديا)
# ========================================

# Meta Pixel + Conversions API
# Pixel ID: from Events Manager → your pixel → Settings
VITE_META_PIXEL_ID=1688029972512451
# Server-side CAPI (same pixel ID + access token from Events Manager → Settings → Conversions API)
META_PIXEL_ID=1688029972512451
META_CAPI_TOKEN=your-capi-access-token

# Facebook/Instagram (Meta Graph API)
# Get from: https://developers.facebook.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# TikTok API
# Get from: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# OAuth Callback URL (update with your domain)
SOCIAL_OAUTH_CALLBACK_URL=https://www.aquavoiq.com/api/social-analytics/callback

# ========================================
# MiroFish — محرك المحاكاة متعدد الوكلاء
# ========================================
# محلياً: شغّل docker-compose -f docker-compose.mirofish.yml up -d
# على السيرفر: استبدل بالرابط الفعلي
MIROFISH_URL=http://localhost:5001

# Zep Cloud — ذاكرة الوكلاء في MiroFish
# مجاني: https://www.getzep.com
ZEP_API_KEY=your-zep-api-key

# Apify (Web Scraping & Automation)
# Get from: https://console.apify.com/account/integrations/api
APIFY_TOKEN=apify_api_xxxx

# Sentry Error Monitoring (get DSN from sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=

# PostHog Product Analytics (get from posthog.com → Project → Settings → Project API key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
