# ========================================
# متغيرات البيئة لـ AQUAVO - Railway
# ========================================

# البيئة
NODE_ENV=production
PORT=5000

# قاعدة البيانات (NEON PostgreSQL)
DATABASE_URL=postgres://user:password@host/database?sslmode=require
# Local QA safety: non-production startup blocks remote DB URLs by default.
# Use true only with a known safe staging/test DB, never production.
ALLOW_REMOTE_DATABASE_IN_DEV=false
# Local browser QA: disable background cron jobs while testing flows.
DISABLE_SCHEDULED_JOBS=false

# الجلسات
SESSION_SECRET=your-very-long-random-secret-here-at-least-32-chars

# Cloudinary (صور المنتجات)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare R2 (صور المراجعات)
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_BUCKET_NAME=aquavo
CLOUDFLARE_CDN_URL=https://your-cdn-url.r2.dev

# Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@aquavoiq.com

# البريد الإلكتروني (Yahoo SMTP)
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yahoo.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yahoo.com

# رابط الموقع العام
VITE_PUBLIC_BASE_URL=https://www.aquavoiq.com
CLIENT_URL=https://www.aquavoiq.com

# Frontend (Vite)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Groq AI (Ultra-fast LLM - Multiple keys for failover)
# Get keys from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY_2=your-backup-groq-key-2
GROQ_API_KEY_3=your-backup-groq-key-3

# Groq Finance Audit (تدقيق المحاسبة الآلي)
# Dedicated API key for finance audit — must NOT fall back to GROQ_API_KEY
FINANCE_GROQ_API_KEY=your-finance-groq-api-key
# Model used for audit reports (default: llama-3.1-8b-instant)
FINANCE_GROQ_MODEL=llama-3.1-8b-instant
# Set to true to enable the audit endpoint + scheduled job (disabled by default for safety)
FINANCE_AI_AUDIT_ENABLED=false
# How often to run the scheduled audit (hours, default: 12)
FINANCE_AI_AUDIT_INTERVAL_HOURS=12
# NEVER set this to true — auto-fix is not implemented and will never be applied automatically
FINANCE_AI_AUTO_FIX=false
# Send Telegram alert even for clean ok reports (default: false — alerts only on warning/critical/failed)
FINANCE_AUDIT_ALERT_ON_OK=false

# ========================================
# Telegram Monitoring Alerts (تنبيهات المراقبة)
# ========================================
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Your Telegram chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ========================================
# Social Media Analytics (تحليلات السوشيال ميديا)
# ========================================

# Meta Pixel + Conversions API
# Pixel ID: from Events Manager → your pixel → Settings
VITE_META_PIXEL_ID=943254634993709
# Server-side CAPI (same pixel ID + access token from Events Manager → Settings → Conversions API)
META_PIXEL_ID=943254634993709
META_CAPI_TOKEN=your-capi-access-token

# Facebook/Instagram (Meta Graph API)
# Get from: https://developers.facebook.com
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# TikTok API
# Get from: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# OAuth Callback URL (update with your domain)
SOCIAL_OAUTH_CALLBACK_URL=https://www.aquavoiq.com/api/social-analytics/callback

# ========================================
# MiroFish — محرك المحاكاة متعدد الوكلاء
# ========================================
# محلياً: شغّل docker-compose -f docker-compose.mirofish.yml up -d
# على السيرفر: استبدل بالرابط الفعلي
MIROFISH_URL=http://localhost:5001

# Zep Cloud — ذاكرة الوكلاء في MiroFish
# مجاني: https://www.getzep.com
ZEP_API_KEY=your-zep-api-key

# Apify (Web Scraping & Automation)
# Get from: https://console.apify.com/account/integrations/api
APIFY_TOKEN=apify_api_xxxx

# Sentry Error Monitoring (get DSN from sentry.io → Project → Settings → Client Keys)
VITE_SENTRY_DSN=

# PostHog Product Analytics (get from posthog.com → Project → Settings → Project API key)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
