{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{server/**,shared/**}"
    },
    "api/ssr-meta.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/nightly",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/weekly-blog",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "0 7 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/mcp/server-card.json>; rel=\"mcp-server-card\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\", </.well-known/acp.json>; rel=\"acp\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://fist-live-server.vercel.app https://api.unsplash.com https://www.google-analytics.com https://plausible.io https://region1.google-analytics.com; frame-ancestors 'self'; object-src 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aquavoiq.com" }],
      "destination": "https://www.aquavoiq.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/mcp/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/agent-skills/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/skills/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/acp.json",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/ucp",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/http-message-signatures-directory",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index"
    },
    {
      "source": "/tiktok:path*.txt",
      "destination": "/tiktok:path*.txt"
    },
    {
      "source": "/privacy-policy/tiktokhuP99SJNhAK32MXVdFftxsGmm4hSjQ1H.txt",
      "destination": "/tiktokhuP99SJNhAK32MXVdFftxsGmm4hSjQ1H.txt"
    },
    {
      "source": "/terms/tiktokPsQMuQ80LSh9pf1oPxdl5GoE3pgSzeGK.txt",
      "destination": "/tiktokPsQMuQ80LSh9pf1oPxdl5GoE3pgSzeGK.txt"
    },
    {
      "source": "/terms/tiktokmBA2KBN0mV5KF3hc5riHIlPHDY5yesht.txt",
      "destination": "/tiktokmBA2KBN0mV5KF3hc5riHIlPHDY5yesht.txt"
    },
    {
      "source": "/((?!api|_next|assets|chunks|entries|.*\\..{2,5}$).*)",
      "destination": "/api/ssr-meta"
    }
  ]
}