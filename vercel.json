{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{server/**,shared/**}"
    },
    "api/ssr-meta.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/ssr-preview.ts": {
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": "{api/**,shared/**,generated/**,server/suppress.ts}"
    },
    "api/blog-ssr.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/product-ssr.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/sitemap-blog.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/pdf.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/nightly",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/weekly-blog",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/finance-audit",
      "schedule": "0 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/guides/:file*.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        }
      ]
    },
    {
      "source": "/assets/guides/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/chunks/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/entries/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/models/(.*).glb",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/((?!oauth).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com https://analytics.tiktok.com https://*.tiktok.com https://tracker.metricool.com https://static.cloudflareinsights.com https://connect.facebook.net https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' blob: https://api.unsplash.com https://www.google-analytics.com https://www.google.com https://region1.google-analytics.com https://analytics.tiktok.com https://*.tiktok.com https://*.tiktokw.us https://*.byteoversea.com https://tracker.metricool.com https://cloudflareinsights.com https://connect.facebook.net https://www.facebook.com https://graph.facebook.com https://us.i.posthog.com https://us-assets.i.posthog.com https://o4509516012191744.ingest.de.sentry.io; worker-src 'self' blob:; frame-src 'self' https://www.facebook.com https://aquavoiq.com https://www.aquavoiq.com; child-src 'self' blob: https://aquavoiq.com https://www.aquavoiq.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "_comment": "Wave 1 merge: absorbed by the canonical nitrogen-cycle hub, which covers every section it had and corrects the three-stage and Nitrobacter errors it taught.",
      "source": "/blog/nitrogen-cycle-simple",
      "destination": "/blog/nitrogen-cycle-simple-arabic-explained",
      "permanent": true
    },
    {
      "_comment": "Wave 1 merge: the surviving article diagnoses by water colour, and this one told readers to change 10-15% of the water daily, which is wrong for a bacterial bloom.",
      "source": "/blog/cloudy-aquarium-water-causes-fix",
      "destination": "/blog/cloudy-water-fix",
      "permanent": true
    },
    {
      "_comment": "Wave 1 merge: the -iraq slug matches local intent and carries the power-cut angle that differentiates the topic here.",
      "source": "/blog/real-vs-fake-plants",
      "destination": "/blog/real-vs-fake-plants-iraq",
      "permanent": true
    },
    {
      "_comment": "Wave 1 three-way merge: absorbed into the summer-heat article, which keeps the strongest local slug.",
      "source": "/blog/iraqi-summer-aquarium-cooling",
      "destination": "/blog/protect-fish-iraqi-summer-50-degrees",
      "permanent": true
    },
    {
      "_comment": "Wave 1 three-way merge: machine-generated timestamp slug, unusable as a URL.",
      "source": "/blog/كيف-تحافظ-على-أجواء-مريحة-لأحواض-السمك-في-حرارة-ال-1788055556978",
      "destination": "/blog/protect-fish-iraqi-summer-50-degrees",
      "permanent": true
    },
    {
      "source": "/guides/aquarium-filter-guide",
      "destination": "/guides/filter-choice",
      "permanent": true
    },
    {
      "source": "/guides/aquarium-heater-guide",
      "destination": "/guides/heater-choice",
      "permanent": true
    },
    {
      "source": "/aquarium-wizard",
      "destination": "/journey",
      "permanent": true
    },
    {
      "source": "/tank-builder",
      "destination": "/journey",
      "permanent": true
    },
    {
      "source": "/fish-health",
      "destination": "/fish-health-diagnosis",
      "permanent": true
    },
    {
      "source": "/fish-doctor",
      "destination": "/fish-health-diagnosis",
      "permanent": true
    },
    {
      "source": "/auth",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/temperature-guide",
      "destination": "/guides/temperature-guide",
      "permanent": true
    },
    {
      "source": "/about-aquavo",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/guides/5-mistakes/",
      "destination": "/guides/5-mistakes",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "aquavoiq.com"
        }
      ],
      "destination": "https://www.aquavoiq.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap-pages.xml",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap-products.xml",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap-guides.xml",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap-blog"
    },
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/openapi.json",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/mcp/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/agent-skills/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/skills/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/acp.json",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/ucp",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/http-message-signatures-directory",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/tiktok:path*.txt",
      "destination": "/tiktok:path*.txt"
    },
    {
      "source": "/privacy-policy/tiktokhuP99SJNhAK32MXVdFftxsGmm4hSjQ1H.txt",
      "destination": "/tiktokhuP99SJNhAK32MXVdFftxsGmm4hSjQ1H.txt"
    },
    {
      "source": "/terms/tiktokPsQMuQ80LSh9pf1oPxdl5GoE3pgSzeGK.txt",
      "destination": "/tiktokPsQMuQ80LSh9pf1oPxdl5GoE3pgSzeGK.txt"
    },
    {
      "source": "/terms/tiktokmBA2KBN0mV5KF3hc5riHIlPHDY5yesht.txt",
      "destination": "/tiktokmBA2KBN0mV5KF3hc5riHIlPHDY5yesht.txt"
    },
    {
      "source": "/((?!api|_next|assets|chunks|entries|.*\\..{2,5}$).*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/ssr-preview"
    },
    {
      "source": "/((?!api|_next|assets|chunks|entries|.*\\..{2,5}$).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Googlebot|Storebot-Google|Google-InspectionTool|GoogleOther|AdsBot-Google|bingbot|BingPreview|DuckDuckBot|YandexBot|Baiduspider|Applebot|Twitterbot|facebookexternalhit|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|GPTBot|ChatGPT-User|OAI-SearchBot|ClaudeBot|Claude-User|PerplexityBot|Amazonbot|Bytespider|PetalBot|CCBot|SiteAuditBot|SemrushBot|AhrefsBot|AhrefsSiteAudit|MJ12bot|DotBot|Screaming Frog SEO Spider|Google-Extended|Meta-ExternalAgent|meta-externalfetcher|anthropic-ai|cohere-ai|DuckAssistBot|YouBot|Diffbot|Timpibot|omgili).*"
        }
      ],
      "destination": "/api/ssr-preview"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-ssr"
    },
    {
      "source": "/products/:slug",
      "destination": "/api/product-ssr"
    },
    {
      "source": "/((?!api|_next|assets|chunks|entries|.*\\..{2,5}$).*)",
      "destination": "/api/ssr-meta"
    }
  ]
}
