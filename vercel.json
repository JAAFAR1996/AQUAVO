{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "{server/**,shared/**}"
    },
    "api/ssr-meta.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/pdf.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/nightly",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/weekly-blog",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/finance-audit",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/guides/:file*.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/pdf" }
      ]
    },
    {
      "source": "/assets/guides/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/chunks/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/entries/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\", </.well-known/mcp/server-card.json>; rel=\"mcp-server-card\", </.well-known/agent-skills/index.json>; rel=\"agent-skills\", </.well-known/acp.json>; rel=\"acp\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://unpkg.com https://www.googletagmanager.com https://www.google-analytics.com https://plausible.io https://analytics.tiktok.com https://*.tiktok.com https://tracker.metricool.com https://static.cloudflareinsights.com https://connect.facebook.net https://us-assets.i.posthog.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' blob: https://api.unsplash.com https://www.google-analytics.com https://plausible.io https://region1.google-analytics.com https://analytics.tiktok.com https://*.tiktok.com https://*.tiktokw.us https://*.byteoversea.com https://tracker.metricool.com https://cloudflareinsights.com https://connect.facebook.net https://www.facebook.com https://graph.facebook.com https://us.i.posthog.com https://us-assets.i.posthog.com https://o4509516012191744.ingest.de.sentry.io; worker-src 'self' blob:; frame-src 'self' https://www.facebook.com https://aquavoiq.com https://www.aquavoiq.com; child-src 'self' blob: https://aquavoiq.com https://www.aquavoiq.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.facebook.com; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guides/5-mistakes",
      "destination": "/guides/5-mistakes/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "aquavoiq.com" }],
      "destination": "https://www.aquavoiq.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/api-catalog",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/mcp/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/agent-skills/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/skills/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/acp.json",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/ucp",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/http-message-signatures-directory",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/openid-configuration",
      "destination": "/api/index"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/index"
    },
    {
      "source": "/oauth/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/tiktok:path*.txt",
      "destination": "/tiktok:path*.txt"
    },
    {
      "source": "/privacy-policy/tiktokhuP99SJNhAK32MXVdFftxsGmm4hSjQ1H.txt",
      "destination": "/tiktokhuP99SJNhAK32MXVdFftxsGmm4hSjQ1H.txt"
    },
    {
      "source": "/terms/tiktokPsQMuQ80LSh9pf1oPxdl5GoE3pgSzeGK.txt",
      "destination": "/tiktokPsQMuQ80LSh9pf1oPxdl5GoE3pgSzeGK.txt"
    },
    {
      "source": "/terms/tiktokmBA2KBN0mV5KF3hc5riHIlPHDY5yesht.txt",
      "destination": "/tiktokmBA2KBN0mV5KF3hc5riHIlPHDY5yesht.txt"
    },
    {
      "source": "/((?!api|_next|assets|chunks|entries|.*\\..{2,5}$).*)",
      "destination": "/api/ssr-meta"
    }
  ]
}
