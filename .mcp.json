{
  "mcpServers": {
    "aquavo-store": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "tsx",
        "server/aquavo-mcp.ts"
      ],
      "cwd": "C:\\Users\\jaafa\\Desktop\\upload\\FishWebClean",
      "env": {
        "ALLOW_REMOTE_DATABASE_IN_DEV": "true",
        "NODE_ENV": "production"
      }
    },
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    }
  }
}
